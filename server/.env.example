# Server Environment Variables

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret for Auth (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# ElevenLabs API (for Text-to-Speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Sarvam API (for Speech-to-Text)
SARVAM_API_KEY=your-sarvam-api-key

# Server Configuration
PORT=5000
NODE_ENV=development

# New Relic Observability (optional)
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=OfferFlow-API
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_LOG=stdout
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_TRANSACTION_TRACER_ENABLED=true
NEW_RELIC_ERROR_COLLECTOR_ENABLED=true
NEW_RELIC_ERROR_COLLECTOR_IGNORE_STATUS_CODES=401,404
NEW_RELIC_ATTRIBUTES_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_METRICS_ENABLED=true
NEW_RELIC_AI_MONITORING_ENABLED=false
NEW_RELIC_AI_MONITORING_RECORD_CONTENT_ENABLED=false

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
