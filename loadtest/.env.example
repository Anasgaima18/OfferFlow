# Copy to .env and source before running k6.
# Local Docker:
BASE_URL=http://localhost:5000
WS_URL=ws://localhost:5000/api/v1/interviews/ws

# Staging on Render:
# BASE_URL=https://offerflow-server-staging.onrender.com
# WS_URL=wss://offerflow-server-staging.onrender.com/api/v1/interviews/ws

# Pre-seeded users (run lib/seed.js first)
USERS_FILE=users.ndjson

# Phase 5 — server /metrics endpoint (only required if METRICS_TOKEN is set)
METRICS_URL=http://localhost:5000/metrics
METRICS_TOKEN=

# Stream k6 metrics into Prometheus (used by docker-compose.observability.yml)
# PROM_OUT=http://localhost:9090/api/v1/write

# F14 — must match server WS_PER_IP_LIMIT / WS_GLOBAL_LIMIT
WS_PER_IP_LIMIT=10
WS_GLOBAL_LIMIT=200

# Tier knob — used by some scripts via lib/config.js
K6_TIER=low

# Test sizing
CONNS=50
SESSION_SECS=300
PEAK=500
VUS=50
SOAK_MIN=30
READ_RPS=20
WRITE_RPS=4
DURATION=5m

# Stage selector for run-all (quick | standard | full)
STAGE=standard

# SLO overrides — only set these if your environment is genuinely slower
# than the post-fix targets. Defaults live in k6/lib/config.js.
# SLO_LB_P95=400
# SLO_SIGNUP_P95=1200
# SLO_WS_AUDIO1_P95=2000
